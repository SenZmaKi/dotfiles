# Local settings run first so startup behavior can be configured per machine.
[[ -f "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
: ${DOTFILES_TMUX_AUTO_ATTACH:=1}
: ${DOTFILES_FASTFETCH:=1}
typeset -U path
path=("$HOME/.local/bin" $path)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
# Plugin versions are managed explicitly by plugins.lock.json.
zstyle ":omz:update" mode disabled
CASE_SENSITIVE=true
DISABLE_MAGIC_FUNCTIONS=true
ENABLE_CORRECTION=true
COMPLETION_WAITING_DOTS=true
plugins=(git)
for plugin in zsh-autosuggestions fast-syntax-highlighting zsh-autocomplete zsh-uv-env; do
  [[ "$TERM" == dumb ]] && continue
  [[ "$plugin" == zsh-uv-env ]] && (( ! $+commands[uv] )) && continue
  [[ -d "$ZSH/custom/plugins/$plugin" ]] && plugins+=($plugin)
done
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
unset plugin

# Portable desktop helpers; fail clearly on headless machines.
open_path() {
  if [[ "$OSTYPE" == darwin* ]]; then command open "$@"
  elif (( $+commands[xdg-open] )); then command xdg-open "$@"
  else print -u2 'No desktop opener available'; return 1; fi
}
clipcopy() {
  if (( $+commands[pbcopy] )); then command pbcopy
  elif [[ -n "$WAYLAND_DISPLAY" ]] && (( $+commands[wl-copy] )); then command wl-copy
  elif [[ -n "$DISPLAY" ]] && (( $+commands[xclip] )); then command xclip -selection clipboard
  else print -u2 'No clipboard available (install wl-clipboard or xclip on Linux)'; return 1; fi
}
alias py=python3
alias nt='open_path .'
alias finder='open_path .'
alias uptodo='git commit -am "Update todo" && git push'
makekey() {
  setopt localoptions pipefail
  if (( $+commands[openssl] )); then
    command openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' | clipcopy
  else print -u2 'makekey requires openssl'; return 1; fi
}
lfcd() {
  local tmp dir
  (( $+commands[lf] )) || return 127
  tmp=$(mktemp) || return
  command lf -last-dir-path="$tmp" "$@"
  dir=$(cat "$tmp")
  rm -f "$tmp"
  [[ -d "$dir" ]] && builtin cd -- "$dir"
}
ZVM_VI_INSERT_ESCAPE_BINDKEY=jk
(( $+widgets[autosuggest-accept] )) && bindkey '^I' autosuggest-accept
bindkey -s '^l' 'lfcd\n'
bindkey -s '^f' 'open_path .\n'
if [[ -z "$SSH_CONNECTION" ]] && (( $+commands[nvim] )); then
  export EDITOR=nvim
else
  export EDITOR=vi
fi
export SUDO_EDITOR="$EDITOR"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
if [[ -o zle && "$TERM" != dumb ]] && (( $+commands[fzf] )); then
  # Older distro releases may not support --zsh.
  eval "$(fzf --zsh 2>/dev/null)"
fi
[[ -o zle && "$TERM" != dumb ]] && (( $+commands[oh-my-posh] )) && eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/cloud-context.omp.json")"

# Attach after initialization so the shell inside tmux has the same environment.
if [[ -o interactive && -t 0 && "$TERM" != dumb && -z "$TMUX" && "$DOTFILES_TMUX_AUTO_ATTACH" == 1 ]] && (( $+commands[tmux] )); then
  latest_session=$(tmux list-sessions -F '#S #{session_last_attached}' 2>/dev/null | sort -k2,2nr | awk 'NR==1 {print $1}')
  if [[ -n "$latest_session" ]]; then
    exec tmux -u attach -t "$latest_session"
  else
    exec tmux -u new -s main
  fi
fi
[[ -o interactive && -t 1 && "$TERM" != dumb && "$DOTFILES_FASTFETCH" == 1 ]] && (( $+commands[fastfetch] )) && fastfetch
return 0
